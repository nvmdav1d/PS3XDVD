# Force LF everywhere. Without this a Windows clone (core.autocrlf=true)
# checks the shell scripts out with CRLF, and the runner then fails with
# "/usr/bin/env: 'bash\r': No such file or directory".
* text=auto eol=lf

*.sh  text eol=lf
*.py  text eol=lf
*.c   text eol=lf
*.h   text eol=lf
Makefile text eol=lf

*.png binary
*.jpg binary
*.iso binary
*.self binary
*.pkg  binary